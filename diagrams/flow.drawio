<mxfile host="app.diagrams.net">
  <diagram id="route-optimizer-flow" name="User Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Route Optimizer - User Flow" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="Open app" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="session" value="Firebase session exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="115" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="login" value="Google Sign-In" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="auth-error" value="Show auth error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="calculator" value="Route calculator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="220" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="destinations" value="Enter 2-15 destinations with Places autocomplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="220" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mode" value="Choose open or closed route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="980" y="225" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="calculate" value="Calculate route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="token" value="Attach Firebase ID token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="370" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="backend" value="Cloud Function validates token, payload and distance radius" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="950" y="355" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="Show optimized route, distance, markers and path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="535" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="route-error" value="Show API error: 100 km radius, auth, network or server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="950" y="535" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="logout" value="Logout returns to login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="480" y="535" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="session" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="No" edge="1" parent="1" source="session" target="login" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Error" edge="1" parent="1" source="login" target="auth-error" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Success / Yes" edge="1" parent="1" source="session" target="calculator" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="login" target="calculator" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="calculator" target="destinations" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="destinations" target="mode" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="mode" target="calculate" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="calculate" target="token" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="token" target="backend" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="200" edge="1" parent="1" source="backend" target="result" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="400/401/500" edge="1" parent="1" source="backend" target="route-error" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" edge="1" parent="1" source="calculator" target="logout" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
