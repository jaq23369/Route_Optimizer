<mxfile host="app.diagrams.net">
  <diagram id="route-optimizer-architecture" name="Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Route Optimizer - System Architecture" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="User Browser" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="60" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="hosting" value="Firebase Hosting&#xa;React + Vite App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="180" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="Firebase Authentication&#xa;Google Sign-In" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="95" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mapsjs" value="Google Maps JavaScript API&#xa;+ Places API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="255" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="function" value="Google Cloud Function&#xa;Python optimize()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value="Firebase Admin SDK&#xa;Verify ID token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="780" y="85" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="distance" value="Distance Matrix API&#xa;Driving distances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="320" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ga" value="Genetic Algorithm&#xa;Open / closed TSP route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1010" y="180" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="env" value="Environment Variables&#xa;Maps key, CORS origin" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1010" y="320" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS" edge="1" parent="1" source="user" target="hosting" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Google login" edge="1" parent="1" source="hosting" target="auth" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="ID token" edge="1" parent="1" source="auth" target="hosting" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Maps + autocomplete" edge="1" parent="1" source="hosting" target="mapsjs" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="POST / optimize&#xa;Bearer token" edge="1" parent="1" source="hosting" target="function" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="verify" edge="1" parent="1" source="function" target="admin" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="distance matrix" edge="1" parent="1" source="function" target="distance" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="matrix" edge="1" parent="1" source="distance" target="function" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="optimize" edge="1" parent="1" source="function" target="ga" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="route result" edge="1" parent="1" source="ga" target="function" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="JSON result" edge="1" parent="1" source="function" target="hosting" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="env" target="function" style="endArrow=block;html=1;rounded=0;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
